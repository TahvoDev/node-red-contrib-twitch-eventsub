    "check": "node scripts/sync-nodes-manifest.js && node test/unit/chat-nodes.test.js && node test/unit/helix-nodes.test.js",
    "sync": "node scripts/sync-nodes-manifest.js --write",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node test/e2e/run-e2e.js",
    "test:unit": "node test/unit/chat-nodes.test.js && node test/unit/helix-nodes.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run check",
    "node-red-check": "node-red-dev validate"
  },
