{
  "name": "@tahvo/node-red-contrib-twitch",
  "version": "0.1.0",
  "description": "Node-RED nodes for Twitch: EventSub events, the Helix REST API and chat over IRC",
  "main": "index.js",
  "homepage": "https://github.com/TahvoDev/node-red-contrib-twitch",
  "repository": "https://github.com/TahvoDev/node-red-contrib-twitch",
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/generate-chat-icons.js && node scripts/copy-static-assets.js && node scripts/generate-eventsub-editor.js && node scripts/check-main-entry.js && node scripts/check-editor-scripts.js && npm run test:unit",
    "collect-glyphs": "node scripts/collect-glyphs.js",
    "check": "npm run test:unit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node test/e2e/run-e2e.js",
    "test:unit": "node test/unit/sanitize-inbound.test.js && node test/unit/plain-output.test.js && node test/unit/chat-nodes.test.js && node test/unit/helix-nodes.test.js && node test/unit/eventsub-nodes.test.js && node test/unit/eventsub-service.test.js && node test/unit/oauth-scopes.test.js && node test/unit/config-status.test.js && node test/unit/redact-secrets.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "node-red-check": "node-red-dev validate",
    "test:e2e:helix": "node test/e2e/run-helix-e2e.js"
  },
  "keywords": [
    "node-red",
    "twitch",
    "stream",
    "rewards",
    "bits",
    "cheer",
    "follow",
    "subscribe"
  ],
  "author": {
    "email": "tahvobiz@pm.me",
    "name": "Tahvo",
    "url": "https://tahvo.tech"
  },
  "license": "MIT",
  "dependencies": {
    "@twurple/api": "^7.3.0",
    "@twurple/auth": "^7.3.0",
    "@twurple/chat": "^7.3.0",
    "@twurple/common": "^7.3.0",
    "@twurple/eventsub-ws": "^7.3.0"
  },
  "node-red": {
    "version": ">=2.0.0",
    "icons": "dist/twitch/icons",
    "nodes": {
      "twitch-api": "dist/twitch/helix/twitch-api.js",
      "twitch-api-config": "dist/twitch/twitch-api-config.js",
      "twitch-chat-announce": "dist/twitch/chat/twitch-chat-announce.js",
      "twitch-chat-ban": "dist/twitch/chat/twitch-chat-ban.js",
      "twitch-chat-clear": "dist/twitch/chat/twitch-chat-clear.js",
      "twitch-chat-command": "dist/twitch/chat/twitch-chat-command.js",
      "twitch-chat-connection": "dist/twitch/chat/twitch-chat-connection.js",
      "twitch-chat-delete-message": "dist/twitch/chat/twitch-chat-delete-message.js",
      "twitch-chat-in": "dist/twitch/chat/twitch-chat-in.js",
      "twitch-chat-join": "dist/twitch/chat/twitch-chat-join.js",
      "twitch-chat-part": "dist/twitch/chat/twitch-chat-part.js",
      "twitch-chat-reply": "dist/twitch/chat/twitch-chat-reply.js",
      "twitch-chat-send": "dist/twitch/chat/twitch-chat-send.js",
      "twitch-chat-timeout": "dist/twitch/chat/twitch-chat-timeout.js",
      "twitch-chat-unban": "dist/twitch/chat/twitch-chat-unban.js",
      "twitch-eventsub": "dist/twitch/eventsub/twitch-eventsub.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node-red": "^1.3.5",
    "shelljs": "^0.10.0",
    "typescript": "^6.0.3"
  }
}
